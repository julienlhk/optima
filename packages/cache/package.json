{
  "name": "@optima/cache",
  "version": "1.0.0",
  "description": "Cache-aware prompt builders and cache-busting linters.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@optima/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
