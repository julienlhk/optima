{
  "name": "@optima/cli",
  "version": "1.0.0",
  "description": "Optima CLI — init, install, doctor, analyze, classify, bench, estimate.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "optima": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "templates", "skills"],
  "scripts": {
    "build": "tsup && node ../../scripts/bundle-cli-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist templates skills"
  },
  "dependencies": {
    "@optima/analyze": "workspace:*",
    "@optima/cache": "workspace:*",
    "@optima/classify": "workspace:*",
    "@optima/compress": "workspace:*",
    "@optima/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
