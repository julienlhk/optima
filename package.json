{
  "name": "ai-opt",
  "version": "1.0.0",
  "private": true,
  "description": "Production AI agent & token optimization monorepo — metering, classification, compression, cache builders, analyzers, and agent skills.",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "pnpm -r --filter './packages/*' run typecheck",
    "ai-opt": "node packages/cli/dist/bin.js",
    "bench": "pnpm --filter @ai-opt/cli exec node dist/bin.js bench",
    "clean": "pnpm -r --filter './packages/*' run clean"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "tsup": "^8.5.0"
  }
}
